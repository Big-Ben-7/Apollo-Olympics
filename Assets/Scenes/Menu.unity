    - target: {fileID: 4018912577303392548, guid: 8f470d64d6ea249038e21e8dbd8f0e3d, type: 3}
      propertyPath: m_text
      value: 'Speed: 1          Agility: 2          Durability: 4         Stability:
        4

        Neptune is the furthest planet from the Sun. It''s known for its
        massive storms with supersonic winds, the fastest in the solar system.

        Ability:
        Neptune''s supersonic winds blast surrounding objects away.

        Cooldown:
        10s'
      objectReference: {fileID: 0}
    - target: {fileID: 4097267508527995609, guid: 8f470d64d6ea249038e21e8dbd8f0e3d, type: 3}
      propertyPath: m_OnClick.m_PersistentCalls.m_Calls.Array.data[0].m_Target
      value: 
      objectReference: {fileID: 79966733}
    - target: {fileID: 4177219944980230070, guid: 8f470d64d6ea249038e21e8dbd8f0e3d, type: 3}
      propertyPath: m_OnClick.m_PersistentCalls.m_Calls.Array.data[0].m_Target
