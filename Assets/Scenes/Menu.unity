    - target: {fileID: 4237361045563747555, guid: 8f470d64d6ea249038e21e8dbd8f0e3d, type: 3}
      propertyPath: m_OnClick.m_PersistentCalls.m_Calls.Array.data[0].m_Target
      value: 
      objectReference: {fileID: 79966733}
    - target: {fileID: 4274610513534270600, guid: 8f470d64d6ea249038e21e8dbd8f0e3d, type: 3}
      propertyPath: m_OnClick.m_PersistentCalls.m_Calls.Array.data[0].m_Target
